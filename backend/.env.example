# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Image generation (Day 2) ---
REPLICATE_API_TOKEN=r8_...

# --- Observability: LangSmith (wired from Day 1) ---
# Newer SDKs read LANGSMITH_*; the older LANGCHAIN_* names still work as aliases.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=content-production-agent

# --- Image storage: Cloudflare R2 ---
# R2 API token → Cloudflare dashboard → R2 → Manage R2 API tokens
# Public URL  → bucket settings → enable public access or use custom domain
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=content-production-agent
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- HITL: Slack notification (notify-only) ---
# Approve/reject happens in the web studio; Slack just posts the review card.
#
# Option A — Bot token (lets the studio UPDATE the card in place after a
# decision: "✅ Approved by … + Download image"). Slack app → OAuth & Permissions
# → add chat:write scope → install → copy the Bot User OAuth Token (xoxb-…).
# Invite the bot to the channel, then set the channel ID (e.g. C0123ABC).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
#
# Option B — Incoming webhook (posts the card but can't edit it afterward).
# Used only if SLACK_BOT_TOKEN/SLACK_CHANNEL are unset.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# Signing secret — required for the interactive "Post to X" button. Slack app →
# Basic Information → App Credentials → Signing Secret. Enable Interactivity and
# set the Request URL to https://<backend-host>/slack/actions
SLACK_SIGNING_SECRET=
#
# Public URL of the Next.js app, used by the card's "Review in app" deep link:
APP_URL=http://localhost:3000

# --- Publishing: Facebook Page (Graph API) ---
# Meta app (developer.facebook.com) in dev mode can post to a Page you admin
# with the pages_manage_posts permission — no App Review needed. Use Graph API
# Explorer to mint a Page access token (ideally long-lived), and grab the Page ID.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
