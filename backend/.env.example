# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Image generation (Day 2) ---
REPLICATE_API_TOKEN=r8_...

# --- Observability: LangSmith (wired from Day 1) ---
# Newer SDKs read LANGSMITH_*; the older LANGCHAIN_* names still work as aliases.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=content-production-agent

# --- Image storage: Cloudflare R2 ---
# R2 API token → Cloudflare dashboard → R2 → Manage R2 API tokens
# Public URL  → bucket settings → enable public access or use custom domain
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=content-production-agent
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- HITL: Slack notification + interactive approval ---
# Incoming webhook posts the review card:
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Signing secret verifies button clicks hitting POST /slack/actions
# (Slack app → Basic Information → App Credentials → Signing Secret).
# Enable Interactivity on the same app and set the Request URL to:
#   https://<your-backend-host>/slack/actions
SLACK_SIGNING_SECRET=
# Public URL of the Next.js app, used by the card's "Open in app" button:
APP_URL=http://localhost:3000
